# Copy to .env for local PostgreSQL runs. Replace all placeholder values.
# Never use the example secret values in a deployed environment.
DB_URL=jdbc:postgresql://localhost:5432/quizora
DB_USER=postgres
DB_PASSWORD=replace-with-a-local-database-password
JWT_SECRET=replace-with-at-least-32-random-characters
CORS_ORIGINS=http://localhost:5500
PORT=8080
